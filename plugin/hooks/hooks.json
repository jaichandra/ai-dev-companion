{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x {{BIN_SH}} ] && {{BIN_SH}} inbox --brief 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
